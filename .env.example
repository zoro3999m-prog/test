# انسخ هذا الملف باسم .env.local محليًا، وأضف نفس القيم في إعدادات مشروعك على Vercel

# رابط قاعدة البيانات (احصل عليه من تبويب Storage > Postgres داخل مشروعك على Vercel)
DATABASE_URL="postgres://user:password@host/dbname?sslmode=require"
DIRECT_URL="postgres://user:password@host/dbname?sslmode=require"

# مفتاح تشفير الجلسات — ولّده بالأمر: openssl rand -base64 32
NEXTAUTH_SECRET="ضع-هنا-نص-عشوائي-طويل"

# رابط الموقع بعد النشر (بدون / في الآخر)
NEXTAUTH_URL="https://your-app.vercel.app"
